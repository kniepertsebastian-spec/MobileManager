# Vorlage für den eigenen Release-Schlüssel. Kopieren nach keystore.properties (wird NICHT eingecheckt)
# und die Werte des in Android Studio erzeugten Keystores eintragen.
# Pfad relativ zum Projektordner; den .jks am besten außerhalb des Repos ablegen (z. B. ../keys/mobilemanager.jks).
storeFile=../keys/mobilemanager-release.jks
storePassword=
keyAlias=mobilemanager
keyPassword=
